      ],
      "source": [
        "# Train models with different dropout rates\n",
        "dropout_rates = [0.0, 0.2, 0.3, 0.5, 0.7]\n",
        "results = {}\n",
        "\n",
        "for dropout_rate in dropout_rates:\n",
        "    print(f\"\\nTraining model with dropout rate: {dropout_rate}\")\n",
        "    model = FeedforwardNN(dropout_rate=dropout_rate)\n",
        "    train_losses, val_losses = train_model(model, train_loader, val_loader, epochs=20)\n",
        "    results[dropout_rate] = {\n",
        "        'model': model,\n",
        "        'train_losses': train_losses,\n",
        "        'val_losses': val_losses\n",
        "    }"
      ]
    },
