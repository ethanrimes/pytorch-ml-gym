      "source": [
        "# Hyperparameters\n",
        "vocab_size = len(vocab)\n",
        "embed_size = 200\n",
        "hidden_size = 200\n",
        "num_layers = 2\n",
        "dropout = 0.5\n",
        "learning_rate = 0.001\n",
        "epochs = 20\n",
        "\n",
        "# Initialize models\n",
        "model_variational = LSTMVariational(vocab_size, embed_size, hidden_size, num_layers, dropout).to(device)\n",
        "model_naive = LSTMNaive(vocab_size, embed_size, hidden_size, num_layers, dropout).to(device)\n",
        "\n",
        "# Loss function\n",
        "criterion = nn.CrossEntropyLoss()\n",
        "\n",
        "# Optimizers\n",
        "optimizer_var = optim.Adam(model_variational.parameters(), lr=learning_rate)\n",
        "optimizer_naive = optim.Adam(model_naive.parameters(), lr=learning_rate)\n",
        "\n",
        "# Training history\n",
        "history_var = {'train_loss': [], 'valid_loss': [], 'train_ppl': [], 'valid_ppl': []}\n",
        "history_naive = {'train_loss': [], 'valid_loss': [], 'train_ppl': [], 'valid_ppl': []}\n",
        "\n",
        "# Train Variational Dropout Model\n",
        "print(\"Training Variational Dropout Model...\")\n",
        "for epoch in range(epochs):\n",
        "    train_loss = train_epoch(model_variational, train_data, criterion, optimizer_var, seq_len)\n",
        "    valid_loss = evaluate(model_variational, valid_data, criterion, seq_len)\n",
        "    \n",
        "    train_ppl = math.exp(train_loss)\n",
        "    valid_ppl = math.exp(valid_loss)\n",
        "    \n",
        "    history_var['train_loss'].append(train_loss)\n",
        "    history_var['valid_loss'].append(valid_loss)\n",
        "    history_var['train_ppl'].append(train_ppl)\n",
        "    history_var['valid_ppl'].append(valid_ppl)\n",
        "    \n",
        "    print(f\"Epoch {epoch+1}/{epochs} | Train Loss: {train_loss:.4f} | Valid Loss: {valid_loss:.4f} | \"\n",
        "          f\"Train PPL: {train_ppl:.2f} | Valid PPL: {valid_ppl:.2f}\")\n",
        "\n",
        "# Train Naive Dropout Model\n",
        "print(\"\\nTraining Naive Dropout Model...\")\n",
        "for epoch in range(epochs):\n",
        "    train_loss = train_epoch(model_naive, train_data, criterion, optimizer_naive, seq_len)\n",
        "    valid_loss = evaluate(model_naive, valid_data, criterion, seq_len)\n",
        "    \n",
        "    train_ppl = math.exp(train_loss)\n",
        "    valid_ppl = math.exp(valid_loss)\n",
        "    \n",
        "    history_naive['train_loss'].append(train_loss)\n",
        "    history_naive['valid_loss'].append(valid_loss)\n",
        "    history_naive['train_ppl'].append(train_ppl)\n",
        "    history_naive['valid_ppl'].append(valid_ppl)\n",
        "    \n",
        "    print(f\"Epoch {epoch+1}/{epochs} | Train Loss: {train_loss:.4f} | Valid Loss: {valid_loss:.4f} | \"\n",
        "          f\"Train PPL: {train_ppl:.2f} | Valid PPL: {valid_ppl:.2f}\")"
      ]
