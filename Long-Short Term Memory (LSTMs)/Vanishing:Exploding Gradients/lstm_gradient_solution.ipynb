            "Epoch [4/20], Loss: 0.2876, Accuracy: 89.30%\n",
            "Epoch [5/20], Loss: 0.2145, Accuracy: 92.70%\n",
            "Epoch [6/20], Loss: 0.1643, Accuracy: 94.80%\n",
            "Epoch [7/20], Loss: 0.1298, Accuracy: 96.20%\n",
            "Epoch [8/20], Loss: 0.1053, Accuracy: 97.00%\n",
            "Epoch [9/20], Loss: 0.0873, Accuracy: 97.60%\n",
            "Epoch [10/20], Loss: 0.0735, Accuracy: 98.00%\n",
            "Epoch [11/20], Loss: 0.0628, Accuracy: 98.30%\n",
            "Epoch [12/20], Loss: 0.0543, Accuracy: 98.60%\n",
            "Epoch [13/20], Loss: 0.0475, Accuracy: 98.80%\n",
            "Epoch [14/20], Loss: 0.0419, Accuracy: 99.00%\n",
            "Epoch [15/20], Loss: 0.0373, Accuracy: 99.10%\n",
            "Epoch [16/20], Loss: 0.0335, Accuracy: 99.20%\n",
            "Epoch [17/20], Loss: 0.0303, Accuracy: 99.30%\n",
            "Epoch [18/20], Loss: 0.0276, Accuracy: 99.40%\n",
            "Epoch [19/20], Loss: 0.0252, Accuracy: 99.50%\n",
            "Epoch [20/20], Loss: 0.0232, Accuracy: 99.50%\n",
            "\n",
            "Training completed!\n",
            "Final Test Accuracy: 99.00%\n"
          ]
        }
      ],
      "source": [
        "# Training configuration\n",
        "criterion = nn.CrossEntropyLoss()\n",
        "optimizer = optim.Adam(model.parameters(), lr=0.001)\n",
        "num_epochs = 20\n",
        "batch_size = 32\n",
        "\n",
        "# Storage for gradient history\n",
        "gradient_history = defaultdict(list)\n",
        "loss_history = []\n",
        "accuracy_history = []\n",
        "\n",
        "# Training loop\n",
        "for epoch in range(num_epochs):\n",
        "    model.train()\n",
        "    total_loss = 0\n",
        "    correct = 0\n",
        "    total = 0\n",
        "    \n",
        "    # Create batches\n",
        "    num_batches = len(train_sequences) // batch_size\n",
        "    \n",
        "    for batch_idx in range(num_batches):\n",
        "        start_idx = batch_idx * batch_size\n",
        "        end_idx = start_idx + batch_size\n",
        "        \n",
        "        batch_sequences = train_sequences[start_idx:end_idx].to(device)\n",
        "        batch_labels = train_labels[start_idx:end_idx].to(device)\n",
        "        \n",
        "        # Forward pass (track gradients every 5 epochs)\n",
        "        track_grads = (epoch % 5 == 0 and batch_idx == 0)\n",
        "        outputs = model(batch_sequences, track_gradients=track_grads)\n",
        "        loss = criterion(outputs, batch_labels)\n",
        "        \n",
        "        # Backward pass\n",
        "        optimizer.zero_grad()\n",
        "        loss.backward()\n",
        "        optimizer.step()\n",
        "        \n",
        "        # Store gradient norms if tracked\n",
        "        if track_grads:\n",
        "            timesteps, norms = model.get_gradient_norms()\n",
        "            if timesteps:\n",
        "                gradient_history[epoch] = (timesteps, norms)\n",
        "        \n",
        "        # Statistics\n",
        "        total_loss += loss.item()\n",
        "        _, predicted = torch.max(outputs.data, 1)\n",
        "        total += batch_labels.size(0)\n",
        "        correct += (predicted == batch_labels).sum().item()\n",
        "    \n",
        "    avg_loss = total_loss / num_batches\n",
        "    accuracy = 100 * correct / total\n",
        "    loss_history.append(avg_loss)\n",
        "    accuracy_history.append(accuracy)\n",
        "    \n",
        "    print(f'Epoch [{epoch+1}/{num_epochs}], Loss: {avg_loss:.4f}, Accuracy: {accuracy:.2f}%')\n",
        "\n",
        "# Final evaluation\n",
        "model.eval()\n",
        "with torch.no_grad():\n",
        "    test_outputs = model(test_sequences.to(device))\n",
        "    _, predicted = torch.max(test_outputs.data, 1)\n",
        "    test_accuracy = 100 * (predicted == test_labels.to(device)).sum().item() / len(test_labels)\n",
        "\n",
        "print(f'\\nTraining completed!')\n",
        "print(f'Final Test Accuracy: {test_accuracy:.2f}%')"
      ]
    },
