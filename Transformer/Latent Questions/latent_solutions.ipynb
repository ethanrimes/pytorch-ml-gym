          "id": "perceiver_basic",
          "title": "Basic Perceiver Block",
          "code": "import torch\nimport torch.nn as nn\nimport torch.nn.functional as F\nimport math\nfrom typing import Optional\n\nclass CrossAttention(nn.Module):\n    \"\"\"Cross-attention where Q comes from one sequence and K,V from another\"\"\"\n    def __init__(self, d_query: int, d_kv: int, num_heads: int, dropout: float = 0.1):\n        super().__init__()\n        assert d_query % num_heads == 0\n        \n        self.d_query = d_query\n        self.d_kv = d_kv\n        self.num_heads = num_heads\n        self.d_k = d_query // num_heads\n        \n        self.W_q = nn.Linear(d_query, d_query)\n        self.W_k = nn.Linear(d_kv, d_query)\n        self.W_v = nn.Linear(d_kv, d_query)\n        self.W_o = nn.Linear(d_query, d_query)\n        \n        self.dropout = nn.Dropout(dropout)\n    \n    def forward(self, query: torch.Tensor, kv: torch.Tensor, \n                mask: Optional[torch.Tensor] = None) -> torch.Tensor:\n        batch_size = query.size(0)\n        query_len = query.size(1)\n        kv_len = kv.size(1)\n        \n        # Project Q from query, K,V from kv\n        Q = self.W_q(query).view(batch_size, query_len, self.num_heads, self.d_k).transpose(1, 2)\n        K = self.W_k(kv).view(batch_size, kv_len, self.num_heads, self.d_k).transpose(1, 2)\n        V = self.W_v(kv).view(batch_size, kv_len, self.num_heads, self.d_k).transpose(1, 2)\n        \n        # Attention scores\n        scores = torch.matmul(Q, K.transpose(-2, -1)) / math.sqrt(self.d_k)\n        \n        if mask is not None:\n            scores = scores.masked_fill(mask == 0, float('-inf'))\n        \n        attn_weights = F.softmax(scores, dim=-1)\n        attn_weights = self.dropout(attn_weights)\n        \n        # Apply attention\n        attn_output = torch.matmul(attn_weights, V)\n        attn_output = attn_output.transpose(1, 2).contiguous().view(batch_size, query_len, self.d_query)\n        \n        return self.W_o(attn_output)\n\n\nclass FeedForward(nn.Module):\n    def __init__(self, d_model: int, d_ff: int, dropout: float = 0.1):\n        super().__init__()\n        self.net = nn.Sequential(\n            nn.Linear(d_model, d_ff),\n            nn.GELU(),\n            nn.Dropout(dropout),\n            nn.Linear(d_ff, d_model),\n            nn.Dropout(dropout)\n        )\n    \n    def forward(self, x: torch.Tensor) -> torch.Tensor:\n        return self.net(x)\n\n\nclass PerceiverBlock(nn.Module):\n    def __init__(self, d_model: int, d_latent: int, num_latents: int, \n                 num_heads: int, d_ff: int = None, dropout: float = 0.1):\n        super().__init__()\n        d_ff = d_ff or 4 * d_latent\n        \n        # Learnable latent array\n        self.latents = nn.Parameter(torch.randn(num_latents, d_latent))\n        \n        # Cross-attention: latents attend to input (compression)\n        self.cross_attn_compress = CrossAttention(d_latent, d_model, num_heads, dropout)\n        \n        # Self-attention in latent space\n        self.self_attn = CrossAttention(d_latent, d_latent, num_heads, dropout)\n        \n        # Cross-attention: output attends to latents (expansion)\n        self.cross_attn_expand = CrossAttention(d_model, d_latent, num_heads, dropout)\n        \n        # Layer norms\n        self.norm1 = nn.LayerNorm(d_latent)\n        self.norm2 = nn.LayerNorm(d_latent)\n        self.norm3 = nn.LayerNorm(d_model)\n        \n        # FFN in latent space\n        self.ffn = FeedForward(d_latent, d_ff, dropout)\n        \n        self.dropout = nn.Dropout(dropout)\n    \n    def forward(self, x: torch.Tensor) -> torch.Tensor:\n        batch_size = x.size(0)\n        \n        # Expand latents for batch: (num_latents, d_latent) -> (batch, num_latents, d_latent)\n        latents = self.latents.unsqueeze(0).expand(batch_size, -1, -1)\n        \n        # Compression: latents attend to input\n        # Q from latents, K,V from input\n        compressed = self.cross_attn_compress(latents, x)\n        latents = self.norm1(latents + self.dropout(compressed))\n        \n        # Processing: self-attention in latent space\n        processed = self.self_attn(latents, latents)\n        latents = self.norm2(latents + self.dropout(processed))\n        \n        # FFN in latent space\n        latents = latents + self.ffn(latents)\n        \n        # Expansion: output attends to latents\n        # Q from input, K,V from latents\n        output = self.cross_attn_expand(x, latents)\n        output = self.norm3(x + self.dropout(output))\n        \n        return output\n\n\n# Example usage\nif __name__ == \"__main__\":\n    batch_size = 4\n    seq_len = 128  # Long input sequence\n    d_model = 256\n    d_latent = 128\n    num_latents = 32  # Much smaller than seq_len!\n    num_heads = 8\n    \n    perceiver = PerceiverBlock(d_model, d_latent, num_latents, num_heads)\n    \n    x = torch.randn(batch_size, seq_len, d_model)\n    output = perceiver(x)\n    \n    print(f\"Input shape: {x.shape}\")\n    print(f\"Output shape: {output.shape}\")\n    print(f\"Latent bottleneck: {num_latents} (vs input {seq_len})\")\n    print(f\"Complexity: O({seq_len}*{num_latents} + {num_latents}^2) vs O({seq_len}^2)\")"
        },
        {
          "id": "perceiver_iterative",
          "title": "Iterative Perceiver",
          "code": "class IterativePerceiver(nn.Module):\n    def __init__(self, d_model: int, d_latent: int, num_latents: int,\n                 num_heads: int, num_iterations: int, d_ff: int = None,\n                 share_processors: bool = True, dropout: float = 0.1):\n        super().__init__()\n        d_ff = d_ff or 4 * d_latent\n        self.num_iterations = num_iterations\n        self.share_processors = share_processors\n        \n        # Learnable latent array\n        self.latents = nn.Parameter(torch.randn(num_latents, d_latent))\n        \n        # Encoder: compress input to latents\n        self.encoder = CrossAttention(d_latent, d_model, num_heads, dropout)\n        self.encoder_norm = nn.LayerNorm(d_latent)\n        \n        # Processor: refine latents (can share weights across iterations)\n        if share_processors:\n            # Single processor block shared across iterations\n            self.processor = nn.ModuleList([\n                CrossAttention(d_latent, d_latent, num_heads, dropout),\n                nn.LayerNorm(d_latent),\n                FeedForward(d_latent, d_ff, dropout),\n                nn.LayerNorm(d_latent)\n            ])\n        else:\n            # Separate processor for each iteration\n            self.processors = nn.ModuleList([\n                nn.ModuleList([\n                    CrossAttention(d_latent, d_latent, num_heads, dropout),\n                    nn.LayerNorm(d_latent),\n                    FeedForward(d_latent, d_ff, dropout),\n                    nn.LayerNorm(d_latent)\n                ]) for _ in range(num_iterations)\n            ])\n        \n        # Decoder: expand latents to output\n        self.decoder = CrossAttention(d_model, d_latent, num_heads, dropout)\n        self.decoder_norm = nn.LayerNorm(d_model)\n        \n        self.dropout = nn.Dropout(dropout)\n    \n    def _process_latents(self, latents: torch.Tensor, iteration: int) -> torch.Tensor:\n        \"\"\"Apply one iteration of latent processing\"\"\"\n        if self.share_processors:\n            self_attn, norm1, ffn, norm2 = self.processor\n        else:\n            self_attn, norm1, ffn, norm2 = self.processors[iteration]\n        \n        # Self-attention\n        attn_out = self_attn(latents, latents)\n        latents = norm1(latents + self.dropout(attn_out))\n        \n        # FFN\n        ffn_out = ffn(latents)\n        latents = norm2(latents + ffn_out)\n        \n        return latents\n    \n    def forward(self, x: torch.Tensor) -> torch.Tensor:\n        batch_size = x.size(0)\n        \n        # Initialize latents\n        latents = self.latents.unsqueeze(0).expand(batch_size, -1, -1)\n        \n        # Encode: compress input into latents\n        encoded = self.encoder(latents, x)\n        latents = self.encoder_norm(latents + self.dropout(encoded))\n        \n        # Process: iteratively refine latents\n        for i in range(self.num_iterations):\n            latents = self._process_latents(latents, i)\n        \n        # Decode: expand latents back to output space\n        output = self.decoder(x, latents)\n        output = self.decoder_norm(x + self.dropout(output))\n        \n        return output\n\n\n# Example usage\nif __name__ == \"__main__\":\n    batch_size = 4\n    seq_len = 256\n    d_model = 512\n    d_latent = 256\n    num_latents = 64\n    num_heads = 8\n    num_iterations = 3\n    \n    # Shared processors (more parameter efficient)\n    perceiver_shared = IterativePerceiver(\n        d_model, d_latent, num_latents, num_heads, \n        num_iterations, share_processors=True\n    )\n    \n    # Separate processors (more expressive)\n    perceiver_separate = IterativePerceiver(\n        d_model, d_latent, num_latents, num_heads,\n        num_iterations, share_processors=False\n    )\n    \n    x = torch.randn(batch_size, seq_len, d_model)\n    \n    output_shared = perceiver_shared(x)\n    output_separate = perceiver_separate(x)\n    \n    print(f\"Input shape: {x.shape}\")\n    print(f\"Output shape (shared): {output_shared.shape}\")\n    print(f\"Output shape (separate): {output_separate.shape}\")\n    print(f\"\\nShared params: {sum(p.numel() for p in perceiver_shared.parameters()):,}\")\n    print(f\"Separate params: {sum(p.numel() for p in perceiver_separate.parameters()):,}\")"
        }
