      "section": "Part 3: RetNet",
      "implementations": [
        {
          "id": "retnet_parallel",
          "title": "Parallel Retention",
          "code": "import torch\nimport torch.nn as nn\nimport torch.nn.functional as F\nimport math\n\nclass ParallelRetention(nn.Module):\n    \"\"\"Parallel retention mechanism for training\"\"\"\n    def __init__(self, d_model: int, num_heads: int, dropout: float = 0.1):\n        super().__init__()\n        assert d_model % num_heads == 0\n        \n        self.d_model = d_model\n        self.num_heads = num_heads\n        self.d_k = d_model // num_heads\n        \n        # Q, K, V projections\n        self.W_q = nn.Linear(d_model, d_model, bias=False)\n        self.W_k = nn.Linear(d_model, d_model, bias=False)\n        self.W_v = nn.Linear(d_model, d_model, bias=False)\n        \n        # Learnable decay parameter per head (γ ∈ (0,1))\n        # Initialize close to 1 for longer memory\n        self.gamma = nn.Parameter(torch.ones(num_heads) * 0.9)\n        \n        # Output projection\n        self.W_o = nn.Linear(d_model, d_model, bias=False)\n        self.dropout = nn.Dropout(dropout)\n    \n    def _build_decay_matrix(self, seq_len: int, gamma: torch.Tensor, device: torch.device) -> torch.Tensor:\n        \"\"\"\n        Build causal decay matrix D where D[i,j] = gamma^(i-j) for i >= j\n        Shape: (num_heads, seq_len, seq_len)\n        \"\"\"\n        # Create position indices\n        i = torch.arange(seq_len, device=device)[:, None]  # (seq_len, 1)\n        j = torch.arange(seq_len, device=device)[None, :]  # (1, seq_len)\n        \n        # Compute decay: gamma^(i-j) for i >= j, 0 otherwise\n        decay_power = (i - j).float()  # (seq_len, seq_len)\n        \n        # Expand gamma to (num_heads, 1, 1) for broadcasting\n        gamma_expanded = gamma.view(self.num_heads, 1, 1)\n        \n        # Compute decay matrix: gamma^(i-j)\n        decay_matrix = torch.pow(gamma_expanded, decay_power)  # (num_heads, seq_len, seq_len)\n        \n        # Apply causal mask (zero out upper triangle where j > i)\n        causal_mask = torch.tril(torch.ones(seq_len, seq_len, device=device))\n        decay_matrix = decay_matrix * causal_mask\n        \n        return decay_matrix\n    \n    def forward(self, x: torch.Tensor) -> torch.Tensor:\n        batch_size, seq_len, _ = x.size()\n        device = x.device\n        \n        # Project Q, K, V and reshape to multi-head\n        Q = self.W_q(x).view(batch_size, seq_len, self.num_heads, self.d_k).transpose(1, 2)\n        K = self.W_k(x).view(batch_size, seq_len, self.num_heads, self.d_k).transpose(1, 2)\n        V = self.W_v(x).view(batch_size, seq_len, self.num_heads, self.d_k).transpose(1, 2)\n        # Shape: (batch, num_heads, seq_len, d_k)\n        \n        # Compute attention scores (without softmax)\n        scores = torch.matmul(Q, K.transpose(-2, -1)) / math.sqrt(self.d_k)\n        # Shape: (batch, num_heads, seq_len, seq_len)\n        \n        # Build decay matrix\n        decay_matrix = self._build_decay_matrix(seq_len, self.gamma, device)\n        # Shape: (num_heads, seq_len, seq_len)\n        \n        # Apply decay (element-wise multiplication)\n        # Expand decay for batch dimension\n        decay_matrix = decay_matrix.unsqueeze(0)  # (1, num_heads, seq_len, seq_len)\n        retention_scores = scores * decay_matrix\n        \n        # NO SOFTMAX - this is key difference from attention!\n        # Optional: apply dropout\n        retention_scores = self.dropout(retention_scores)\n        \n        # Apply to values\n        retention_output = torch.matmul(retention_scores, V)\n        # Shape: (batch, num_heads, seq_len, d_k)\n        \n        # Concatenate heads\n        retention_output = retention_output.transpose(1, 2).contiguous()\n        retention_output = retention_output.view(batch_size, seq_len, self.d_model)\n        \n        # Output projection\n        output = self.W_o(retention_output)\n        \n        return output\n\n\n# Example usage\nif __name__ == \"__main__\":\n    batch_size = 4\n    seq_len = 32\n    d_model = 256\n    num_heads = 8\n    \n    retention = ParallelRetention(d_model, num_heads)\n    \n    x = torch.randn(batch_size, seq_len, d_model)\n    output = retention(x)\n    \n    print(f\"Input shape: {x.shape}\")\n    print(f\"Output shape: {output.shape}\")\n    print(f\"Gamma values (decay rates): {retention.gamma}\")\n    print(f\"\\nComplexity: O(N^2) in parallel mode (training)\")\n    print(f\"But can be computed in O(N) recurrently (inference)!\")"
        },
