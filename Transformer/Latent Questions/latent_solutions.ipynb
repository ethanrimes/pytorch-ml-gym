          "code": "import time\nimport torch\nimport torch.nn as nn\nfrom typing import Dict, List\nimport matplotlib.pyplot as plt\n\nclass ArchitectureBenchmark:\n    def __init__(self, d_model: int = 512, batch_size: int = 4):\n        self.d_model = d_model\n        self.batch_size = batch_size\n        self.device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n        \n        # Initialize models\n        self.models = {\n            'Transformer': self._make_transformer(),\n            'Perceiver': self._make_perceiver(),\n            'DeepSeek MLA': self._make_mla(),\n            'RetNet': self._make_retnet(),\n            'Mamba': self._make_mamba()\n        }\n    \n    def _make_transformer(self):\n        from torch.nn import TransformerEncoderLayer\n        return TransformerEncoderLayer(\n            d_model=self.d_model,\n            nhead=8,\n            dim_feedforward=2048,\n            batch_first=True\n        ).to(self.device)\n    \n    def _make_perceiver(self):\n        return PerceiverBlock(\n            d_model=self.d_model,\n            d_latent=256,\n            num_latents=64,\n            num_heads=8\n        ).to(self.device)\n    \n    def _make_mla(self):\n        return MultiHeadLatentAttention(\n            d_model=self.d_model,\n            num_heads=8,\n            c_kv=128\n        ).to(self.device)\n    \n    def _make_retnet(self):\n        return RetNetBlock(\n            d_model=self.d_model,\n            num_heads=8,\n            d_ff=2048\n        ).to(self.device)\n    \n    def _make_mamba(self):\n        return MambaBlock(\n            d_model=self.d_model,\n            d_state=16\n        ).to(self.device)\n    \n    def benchmark_training(self, seq_lens: List[int], num_iterations: int = 100) -> Dict[str, List[float]]:\n        \"\"\"Measure training time (forward + backward)\"\"\"\n        results = {name: [] for name in self.models.keys()}\n        \n        for seq_len in seq_lens:\n            print(f\"\\nBenchmarking training at seq_len={seq_len}\")\n            x = torch.randn(self.batch_size, seq_len, self.d_model, device=self.device)\n            \n            for name, model in self.models.items():\n                model.train()\n                \n                # Warmup\n                for _ in range(10):\n                    if name == 'RetNet':\n                        out, _ = model(x, mode='parallel')\n                    elif name == 'DeepSeek MLA':\n                        out, _ = model(x)\n                    else:\n                        out = model(x)\n                    \n                    loss = out.sum()\n                    loss.backward()\n                    model.zero_grad()\n                \n                # Benchmark\n                torch.cuda.synchronize() if torch.cuda.is_available() else None\n                start = time.time()\n                \n                for _ in range(num_iterations):\n                    if name == 'RetNet':\n                        out, _ = model(x, mode='parallel')\n                    elif name == 'DeepSeek MLA':\n                        out, _ = model(x)\n                    else:\n                        out = model(x)\n                    \n                    loss = out.sum()\n                    loss.backward()\n                    model.zero_grad()\n                \n                torch.cuda.synchronize() if torch.cuda.is_available() else None\n                elapsed = time.time() - start\n                \n                avg_time = elapsed / num_iterations * 1000  # ms\n                results[name].append(avg_time)\n                print(f\"  {name}: {avg_time:.2f} ms\")\n        \n        return results\n    \n    def benchmark_inference(self, seq_lens: List[int], num_tokens_to_generate: int = 50) -> Dict[str, List[float]]:\n        \"\"\"Measure inference time (generation)\"\"\"\n        results = {name: [] for name in self.models.keys()}\n        \n        for seq_len in seq_lens:\n            print(f\"\\nBenchmarking inference at seq_len={seq_len}\")\n            x = torch.randn(self.batch_size, seq_len, self.d_model, device=self.device)\n            \n            for name, model in self.models.items():\n                model.eval()\n                \n                with torch.no_grad():\n                    # Warmup\n                    for _ in range(5):\n                        _ = model(x)\n                    \n                    # Benchmark generation\n                    torch.cuda.synchronize() if torch.cuda.is_available() else None\n                    start = time.time()\n                    \n                    # Simulate autoregressive generation\n                    cache = None\n                    for i in range(num_tokens_to_generate):\n                        token = torch.randn(self.batch_size, 1, self.d_model, device=self.device)\n                        \n                        if name == 'RetNet':\n                            _, cache = model(token, mode='recurrent', state=cache)\n                        elif name == 'DeepSeek MLA':\n                            _, cache = model(token, cache=cache)\n                        else:\n                            # For others, use full sequence (less efficient)\n                            _ = model(torch.cat([x, token], dim=1) if i == 0 else torch.cat([prev, token], dim=1))\n                            prev = torch.cat([x, token], dim=1) if i == 0 else torch.cat([prev, token], dim=1)\n                    \n                    torch.cuda.synchronize() if torch.cuda.is_available() else None\n                    elapsed = time.time() - start\n                \n                tokens_per_sec = num_tokens_to_generate / elapsed\n                results[name].append(tokens_per_sec)\n                print(f\"  {name}: {tokens_per_sec:.1f} tokens/sec\")\n        \n        return results\n    \n    def benchmark_memory(self, seq_lens: List[int]) -> Dict[str, List[float]]:\n        \"\"\"Measure peak memory usage\"\"\"\n        results = {name: [] for name in self.models.keys()}\n        \n        for seq_len in seq_lens:\n            print(f\"\\nBenchmarking memory at seq_len={seq_len}\")\n            \n            for name, model in self.models.items():\n                if torch.cuda.is_available():\n                    torch.cuda.reset_peak_memory_stats()\n                    torch.cuda.empty_cache()\n                    \n                    x = torch.randn(self.batch_size, seq_len, self.d_model, device=self.device)\n                    \n                    if name == 'RetNet':\n                        out, _ = model(x, mode='parallel')\n                    elif name == 'DeepSeek MLA':\n                        out, _ = model(x)\n                    else:\n                        out = model(x)\n                    \n                    loss = out.sum()\n                    loss.backward()\n                    \n                    peak_mem = torch.cuda.max_memory_allocated() / 1024**2  # MB\n                    results[name].append(peak_mem)\n                    print(f\"  {name}: {peak_mem:.1f} MB\")\n                else:\n                    # CPU memory tracking is less reliable\n                    results[name].append(0)\n        \n        return results\n    \n    def plot_results(self, seq_lens: List[int], \n                    training_results: Dict, \n                    inference_results: Dict, \n                    memory_results: Dict):\n        \"\"\"Plot benchmark results\"\"\"\n        fig, axes = plt.subplots(1, 3, figsize=(15, 4))\n        \n        # Training time\n        for name, times in training_results.items():\n            axes[0].plot(seq_lens, times, marker='o', label=name)\n        axes[0].set_xlabel('Sequence Length')\n        axes[0].set_ylabel('Time (ms)')\n        axes[0].set_title('Training Time (Forward + Backward)')\n        axes[0].legend()\n        axes[0].grid(True)\n        \n        # Inference speed\n        for name, speeds in inference_results.items():\n            axes[1].plot(seq_lens, speeds, marker='o', label=name)\n        axes[1].set_xlabel('Sequence Length')\n        axes[1].set_ylabel('Tokens/Second')\n        axes[1].set_title('Inference Speed')\n        axes[1].legend()\n        axes[1].grid(True)\n        \n        # Memory usage\n        for name, mems in memory_results.items():\n            axes[2].plot(seq_lens, mems, marker='o', label=name)\n        axes[2].set_xlabel('Sequence Length')\n        axes[2].set_ylabel('Memory (MB)')\n        axes[2].set_title('Peak Memory Usage')\n        axes[2].legend()\n        axes[2].grid(True)\n        \n        plt.tight_layout()\n        plt.savefig('architecture_benchmark.png')\n        print(\"\\nPlot saved to architecture_benchmark.png\")\n\n\n# Run benchmark\nif __name__ == \"__main__\":\n    print(\"=== Architecture Benchmark ===\")\n    print(\"Comparing: Transformer, Perceiver, MLA, RetNet, Mamba\\n\")\n    \n    benchmark = ArchitectureBenchmark(d_model=512, batch_size=4)\n    seq_lens = [64, 128, 256, 512]\n    \n    # Run benchmarks\n    print(\"\\n\" + \"=\"*50)\n    print(\"TRAINING BENCHMARK\")\n    print(\"=\"*50)\n    training_results = benchmark.benchmark_training(seq_lens, num_iterations=50)\n    \n    print(\"\\n\" + \"=\"*50)\n    print(\"INFERENCE BENCHMARK\")\n    print(\"=\"*50)\n    inference_results = benchmark.benchmark_inference(seq_lens, num_tokens_to_generate=50)\n    \n    print(\"\\n\" + \"=\"*50)\n    print(\"MEMORY BENCHMARK\")\n    print(\"=\"*50)\n    memory_results = benchmark.benchmark_memory(seq_lens)\n    \n    # Plot results\n    benchmark.plot_results(seq_lens, training_results, inference_results, memory_results)\n    \n    print(\"\\n\" + \"=\"*50)\n    print(\"KEY TAKEAWAYS\")\n    print(\"=\"*50)\n    print(\"Transformer: O(N²) complexity, best quality, expensive for long sequences\")\n    print(\"Perceiver: O(NM) complexity, good for very long sequences, quality depends on M\")\n    print(\"MLA: Reduced KV cache, good for long-context inference\")\n    print(\"RetNet: O(N) training, O(1) inference, excellent for generation\")\n    print(\"Mamba: O(N) always, fixed memory, great for long sequences\")"
