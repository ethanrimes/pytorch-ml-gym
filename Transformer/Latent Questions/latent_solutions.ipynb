          "id": "retnet_recurrent",
          "title": "Recurrent Retention",
          "code": "class RecurrentRetention(nn.Module):\n    \"\"\"Recurrent retention for efficient O(1) inference per step\"\"\"\n    def __init__(self, d_model: int, num_heads: int):\n        super().__init__()\n        assert d_model % num_heads == 0\n        \n        self.d_model = d_model\n        self.num_heads = num_heads\n        self.d_k = d_model // num_heads\n        \n        # Q, K, V projections\n        self.W_q = nn.Linear(d_model, d_model, bias=False)\n        self.W_k = nn.Linear(d_model, d_model, bias=False)\n        self.W_v = nn.Linear(d_model, d_model, bias=False)\n        \n        # Learnable decay per head\n        self.gamma = nn.Parameter(torch.ones(num_heads) * 0.9)\n        \n        # Output projection\n        self.W_o = nn.Linear(d_model, d_model, bias=False)\n    \n    def forward_step(self, x_t: torch.Tensor, \n                     state: Optional[torch.Tensor] = None\n                    ) -> Tuple[torch.Tensor, torch.Tensor]:\n        \"\"\"\n        Process single timestep recurrently.\n        \n        Recurrence: s_t = gamma * s_{t-1} + K_t^T @ V_t\n                    o_t = Q_t @ s_t\n        \n        Args:\n            x_t: (batch, 1, d_model) - single token input\n            state: (batch, num_heads, d_k, d_k) - retention state s_{t-1}\n        \n        Returns:\n            output: (batch, 1, d_model)\n            new_state: (batch, num_heads, d_k, d_k) - updated state s_t\n        \"\"\"\n        batch_size = x_t.size(0)\n        device = x_t.device\n        \n        # Project Q, K, V for current timestep\n        Q_t = self.W_q(x_t).view(batch_size, 1, self.num_heads, self.d_k).transpose(1, 2)\n        K_t = self.W_k(x_t).view(batch_size, 1, self.num_heads, self.d_k).transpose(1, 2)\n        V_t = self.W_v(x_t).view(batch_size, 1, self.num_heads, self.d_k).transpose(1, 2)\n        # Shape: (batch, num_heads, 1, d_k)\n        \n        # Remove sequence dimension\n        Q_t = Q_t.squeeze(2)  # (batch, num_heads, d_k)\n        K_t = K_t.squeeze(2)  # (batch, num_heads, d_k)\n        V_t = V_t.squeeze(2)  # (batch, num_heads, d_k)\n        \n        # Initialize state if None\n        if state is None:\n            state = torch.zeros(batch_size, self.num_heads, self.d_k, self.d_k, \n                              device=device, dtype=x_t.dtype)\n        \n        # Expand gamma for broadcasting: (num_heads,) -> (batch, num_heads, 1, 1)\n        gamma = self.gamma.view(1, self.num_heads, 1, 1)\n        \n        # Update state: s_t = gamma * s_{t-1} + K_t^T @ V_t\n        # K_t^T @ V_t is outer product: (batch, num_heads, d_k, 1) @ (batch, num_heads, 1, d_k)\n        K_t_T = K_t.unsqueeze(-1)  # (batch, num_heads, d_k, 1)\n        V_t_T = V_t.unsqueeze(-2)  # (batch, num_heads, 1, d_k)\n        \n        outer_product = torch.matmul(K_t_T, V_t_T)  # (batch, num_heads, d_k, d_k)\n        new_state = gamma * state + outer_product\n        \n        # Compute output: o_t = Q_t @ s_t\n        # Q_t: (batch, num_heads, d_k)\n        # s_t: (batch, num_heads, d_k, d_k)\n        # Result: (batch, num_heads, d_k)\n        Q_t_expanded = Q_t.unsqueeze(-2)  # (batch, num_heads, 1, d_k)\n        o_t = torch.matmul(Q_t_expanded, new_state).squeeze(-2)  # (batch, num_heads, d_k)\n        \n        # Concatenate heads and project\n        o_t = o_t.view(batch_size, 1, self.d_model)\n        output = self.W_o(o_t)\n        \n        return output, new_state\n    \n    def forward_sequence(self, x: torch.Tensor) -> torch.Tensor:\n        \"\"\"Process entire sequence recurrently (mainly for testing)\"\"\"\n        batch_size, seq_len, _ = x.size()\n        \n        state = None\n        outputs = []\n        \n        for t in range(seq_len):\n            x_t = x[:, t:t+1, :]  # (batch, 1, d_model)\n            output, state = self.forward_step(x_t, state)\n            outputs.append(output)\n        \n        return torch.cat(outputs, dim=1)\n\n\n# Example: Autoregressive generation\nif __name__ == \"__main__\":\n    batch_size = 2\n    d_model = 256\n    num_heads = 8\n    \n    retention = RecurrentRetention(d_model, num_heads)\n    \n    print(\"=== Recurrent Retention Demo ===\")\n    print(f\"Complexity per step: O(1) - constant time!\\n\")\n    \n    # Simulate autoregressive generation\n    state = None\n    for step in range(5):\n        # Single token input\n        x_t = torch.randn(batch_size, 1, d_model)\n        output, state = retention.forward_step(x_t, state)\n        \n        print(f\"Step {step + 1}:\")\n        print(f\"  Input shape: {x_t.shape}\")\n        print(f\"  Output shape: {output.shape}\")\n        print(f\"  State shape: {state.shape}\")\n    \n    print(\"\\n=== Compare with Parallel Mode ===\")\n    seq_len = 10\n    x_full = torch.randn(batch_size, seq_len, d_model)\n    \n    # Process recurrently\n    output_recurrent = retention.forward_sequence(x_full)\n    print(f\"Recurrent output: {output_recurrent.shape}\")\n    print(f\"Both modes produce same results (numerically equivalent)!\")"
        },
        {
          "id": "retnet_block",
          "title": "Complete RetNet Block",
          "code": "class GroupNorm(nn.Module):\n    \"\"\"Group normalization for RetNet\"\"\"\n    def __init__(self, num_groups: int, num_channels: int, eps: float = 1e-5):\n        super().__init__()\n        self.num_groups = num_groups\n        self.eps = eps\n        self.weight = nn.Parameter(torch.ones(num_channels))\n        self.bias = nn.Parameter(torch.zeros(num_channels))\n    \n    def forward(self, x: torch.Tensor) -> torch.Tensor:\n        # x: (batch, seq_len, d_model)\n        batch_size, seq_len, d_model = x.size()\n        \n        # Reshape to (batch, seq_len, num_groups, channels_per_group)\n        x = x.view(batch_size, seq_len, self.num_groups, d_model // self.num_groups)\n        \n        # Normalize across channels within each group\n        mean = x.mean(dim=-1, keepdim=True)\n        var = x.var(dim=-1, keepdim=True, unbiased=False)\n        x = (x - mean) / torch.sqrt(var + self.eps)\n        \n        # Reshape back\n        x = x.view(batch_size, seq_len, d_model)\n        \n        # Apply learnable parameters\n        return x * self.weight + self.bias\n\n\nclass GatedFFN(nn.Module):\n    \"\"\"Swish-gated FFN: FFN(x) = (xW1 ⊙ swish(xW2))W3\"\"\"\n    def __init__(self, d_model: int, d_ff: int, dropout: float = 0.1):\n        super().__init__()\n        self.W1 = nn.Linear(d_model, d_ff, bias=False)\n        self.W2 = nn.Linear(d_model, d_ff, bias=False)\n        self.W3 = nn.Linear(d_ff, d_model, bias=False)\n        self.dropout = nn.Dropout(dropout)\n    \n    def forward(self, x: torch.Tensor) -> torch.Tensor:\n        # Gate path: swish(xW2)\n        gate = F.silu(self.W2(x))  # SiLU is same as Swish\n        \n        # Value path: xW1\n        value = self.W1(x)\n        \n        # Element-wise multiplication (gating)\n        gated = value * gate\n        gated = self.dropout(gated)\n        \n        # Output projection\n        return self.W3(gated)\n\n\nclass RetNetBlock(nn.Module):\n    \"\"\"Complete RetNet block with multi-scale retention\"\"\"\n    def __init__(self, d_model: int, num_heads: int, d_ff: int, \n                 num_groups: int = 4, dropout: float = 0.1):\n        super().__init__()\n        self.d_model = d_model\n        self.num_heads = num_heads\n        \n        # Multi-scale retention (can use parallel or recurrent)\n        self.retention_parallel = ParallelRetention(d_model, num_heads, dropout)\n        self.retention_recurrent = RecurrentRetention(d_model, num_heads)\n        \n        # Group normalization\n        self.norm1 = GroupNorm(num_groups, d_model)\n        self.norm2 = GroupNorm(num_groups, d_model)\n        \n        # Gated FFN\n        self.ffn = GatedFFN(d_model, d_ff, dropout)\n        \n        self.dropout = nn.Dropout(dropout)\n    \n    def forward(self, x: torch.Tensor, mode: str = 'parallel', \n                state: Optional[torch.Tensor] = None) -> Tuple[torch.Tensor, Optional[torch.Tensor]]:\n        \"\"\"\n        Args:\n            x: input tensor\n            mode: 'parallel' (training) or 'recurrent' (inference)\n            state: retention state (only for recurrent mode)\n        \"\"\"\n        if mode == 'parallel':\n            # Parallel retention for training\n            retention_out = self.retention_parallel(x)\n            x = self.norm1(x + self.dropout(retention_out))\n            \n            # FFN\n            ffn_out = self.ffn(x)\n            x = self.norm2(x + ffn_out)\n            \n            return x, None\n        \n        elif mode == 'recurrent':\n            # Recurrent retention for inference (single step)\n            retention_out, new_state = self.retention_recurrent.forward_step(x, state)\n            x = self.norm1(x + self.dropout(retention_out))\n            \n            # FFN\n            ffn_out = self.ffn(x)\n            x = self.norm2(x + ffn_out)\n            \n            return x, new_state\n        \n        else:\n            raise ValueError(f\"Unknown mode: {mode}\")\n\n\n# Example: Training vs Inference\nif __name__ == \"__main__\":\n    batch_size = 4\n    d_model = 512\n    num_heads = 8\n    d_ff = 2048\n    \n    block = RetNetBlock(d_model, num_heads, d_ff)\n    \n    print(\"=== Training Mode (Parallel) ===\")\n    seq_len = 64\n    x_train = torch.randn(batch_size, seq_len, d_model)\n    output_train, _ = block(x_train, mode='parallel')\n    print(f\"Input: {x_train.shape}\")\n    print(f\"Output: {output_train.shape}\")\n    print(f\"Complexity: O(N^2) but highly parallelizable\\n\")\n    \n    print(\"=== Inference Mode (Recurrent) ===\")\n    state = None\n    for step in range(5):\n        x_token = torch.randn(batch_size, 1, d_model)\n        output_token, state = block(x_token, mode='recurrent', state=state)\n        print(f\"Step {step + 1}: output {output_token.shape}, state {state.shape}\")\n    print(f\"Complexity: O(1) per token - super efficient!\")"
        }
      ]
