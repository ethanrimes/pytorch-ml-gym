      "section": "Part 2: DeepSeek MLA",
      "implementations": [
        {
          "id": "deepseek_mla_basic",
          "title": "DeepSeek MLA Core",
          "code": "import torch\nimport torch.nn as nn\nimport torch.nn.functional as F\nimport math\nfrom typing import Optional, Tuple\n\nclass MultiHeadLatentAttention(nn.Module):\n    \"\"\"DeepSeek-V2 Multi-head Latent Attention with KV compression\"\"\"\n    def __init__(self, d_model: int, num_heads: int, c_kv: int, dropout: float = 0.1):\n        super().__init__()\n        assert d_model % num_heads == 0\n        \n        self.d_model = d_model\n        self.num_heads = num_heads\n        self.d_k = d_model // num_heads\n        self.c_kv = c_kv  # Compressed KV dimension (much smaller than d_model)\n        \n        # Query projection (full dimension)\n        self.W_q = nn.Linear(d_model, d_model, bias=False)\n        \n        # KV compression: d_model -> c_kv (low-rank bottleneck)\n        self.kv_compress = nn.Linear(d_model, c_kv, bias=False)\n        \n        # KV decompression: c_kv -> (num_heads * d_k) for both K and V\n        # Separate decompression for K and V\n        self.k_decompress = nn.Linear(c_kv, d_model, bias=False)\n        self.v_decompress = nn.Linear(c_kv, d_model, bias=False)\n        \n        # Output projection\n        self.W_o = nn.Linear(d_model, d_model, bias=False)\n        \n        self.dropout = nn.Dropout(dropout)\n    \n    def forward(self, x: torch.Tensor, \n                cache: Optional[Tuple[torch.Tensor, torch.Tensor]] = None\n               ) -> Tuple[torch.Tensor, Tuple[torch.Tensor, torch.Tensor]]:\n        batch_size, seq_len, _ = x.size()\n        \n        # Project Q normally (full dimension)\n        Q = self.W_q(x).view(batch_size, seq_len, self.num_heads, self.d_k).transpose(1, 2)\n        # Q shape: (batch, num_heads, seq_len, d_k)\n        \n        # Compress K,V to latent representation\n        kv_compressed = self.kv_compress(x)  # (batch, seq_len, c_kv)\n        \n        # Handle cache\n        if cache is not None:\n            cached_kv_compressed = cache\n            # Concatenate with cached compressed representations\n            kv_compressed_full = torch.cat([cached_kv_compressed, kv_compressed], dim=1)\n        else:\n            kv_compressed_full = kv_compressed\n        \n        # Decompress K,V for attention computation\n        K_full = self.k_decompress(kv_compressed_full)  # (batch, seq_len_full, d_model)\n        V_full = self.v_decompress(kv_compressed_full)  # (batch, seq_len_full, d_model)\n        \n        # Reshape to multi-head format\n        seq_len_full = K_full.size(1)\n        K = K_full.view(batch_size, seq_len_full, self.num_heads, self.d_k).transpose(1, 2)\n        V = V_full.view(batch_size, seq_len_full, self.num_heads, self.d_k).transpose(1, 2)\n        # K,V shape: (batch, num_heads, seq_len_full, d_k)\n        \n        # Compute attention\n        scores = torch.matmul(Q, K.transpose(-2, -1)) / math.sqrt(self.d_k)\n        # scores shape: (batch, num_heads, seq_len, seq_len_full)\n        \n        # Causal mask (for decoder)\n        mask = torch.tril(torch.ones(seq_len, seq_len_full, device=x.device))\n        mask = mask.view(1, 1, seq_len, seq_len_full)\n        scores = scores.masked_fill(mask == 0, float('-inf'))\n        \n        # Softmax and dropout\n        attn_weights = F.softmax(scores, dim=-1)\n        attn_weights = self.dropout(attn_weights)\n        \n        # Apply attention to values\n        attn_output = torch.matmul(attn_weights, V)\n        # attn_output shape: (batch, num_heads, seq_len, d_k)\n        \n        # Concatenate heads\n        attn_output = attn_output.transpose(1, 2).contiguous().view(batch_size, seq_len, self.d_model)\n        \n        # Output projection\n        output = self.W_o(attn_output)\n        \n        # Return output and updated cache (compressed KV)\n        return output, kv_compressed_full\n\n\n# Example usage and benchmarking\nif __name__ == \"__main__\":\n    batch_size = 4\n    seq_len = 128\n    d_model = 4096  # Large model dimension\n    num_heads = 32\n    c_kv = 512  # Compressed dimension (much smaller!)\n    \n    mla = MultiHeadLatentAttention(d_model, num_heads, c_kv)\n    \n    x = torch.randn(batch_size, seq_len, d_model)\n    output, cache = mla(x)\n    \n    print(f\"Input shape: {x.shape}\")\n    print(f\"Output shape: {output.shape}\")\n    print(f\"Cache shape (compressed KV): {cache.shape}\")\n    print(f\"\\nMemory savings:\")\n    \n    # Traditional KV cache size\n    d_k = d_model // num_heads\n    traditional_kv_size = 2 * batch_size * seq_len * num_heads * d_k\n    # MLA compressed cache size\n    mla_cache_size = batch_size * seq_len * c_kv\n    \n    print(f\"Traditional KV cache: {traditional_kv_size:,} elements\")\n    print(f\"MLA compressed cache: {mla_cache_size:,} elements\")\n    print(f\"Compression ratio: {traditional_kv_size / mla_cache_size:.1f}x\")\n    print(f\"Memory savings: {(1 - mla_cache_size/traditional_kv_size)*100:.1f}%\")"
        },
        {
          "id": "deepseek_mla_rope",
          "title": "MLA with RoPE Integration",
          "code": "class RotaryPositionalEmbedding(nn.Module):\n    def __init__(self, d_model: int, max_len: int = 8192):\n        super().__init__()\n        assert d_model % 2 == 0\n        \n        inv_freq = 1.0 / (10000 ** (torch.arange(0, d_model, 2).float() / d_model))\n        self.register_buffer('inv_freq', inv_freq)\n        \n        t = torch.arange(max_len, dtype=torch.float)\n        freqs = torch.outer(t, inv_freq)\n        emb = torch.cat([freqs, freqs], dim=-1)\n        \n        self.register_buffer('cos_cached', emb.cos())\n        self.register_buffer('sin_cached', emb.sin())\n    \n    def rotate_half(self, x: torch.Tensor) -> torch.Tensor:\n        x1, x2 = x[..., :x.shape[-1]//2], x[..., x.shape[-1]//2:]\n        return torch.cat([-x2, x1], dim=-1)\n    \n    def forward(self, q: torch.Tensor, k: torch.Tensor, \n                start_pos: int = 0) -> Tuple[torch.Tensor, torch.Tensor]:\n        seq_len = q.size(-2)\n        \n        cos = self.cos_cached[start_pos:start_pos+seq_len, :].unsqueeze(0).unsqueeze(0)\n        sin = self.sin_cached[start_pos:start_pos+seq_len, :].unsqueeze(0).unsqueeze(0)\n        \n        q_rot = q * cos + self.rotate_half(q) * sin\n        k_rot = k * cos + self.rotate_half(k) * sin\n        \n        return q_rot, k_rot\n\n\nclass MLAWithRoPE(nn.Module):\n    \"\"\"DeepSeek MLA with Rotary Position Embeddings\"\"\"\n    def __init__(self, d_model: int, num_heads: int, c_kv: int, max_len: int = 8192):\n        super().__init__()\n        assert d_model % num_heads == 0\n        \n        self.d_model = d_model\n        self.num_heads = num_heads\n        self.d_k = d_model // num_heads\n        self.c_kv = c_kv\n        \n        # Q projection\n        self.W_q = nn.Linear(d_model, d_model, bias=False)\n        \n        # KV compression and decompression\n        self.kv_compress = nn.Linear(d_model, c_kv, bias=False)\n        self.k_decompress = nn.Linear(c_kv, d_model, bias=False)\n        self.v_decompress = nn.Linear(c_kv, d_model, bias=False)\n        \n        # RoPE\n        self.rope = RotaryPositionalEmbedding(self.d_k, max_len)\n        \n        # Output\n        self.W_o = nn.Linear(d_model, d_model, bias=False)\n        self.dropout = nn.Dropout(0.1)\n    \n    def forward(self, x: torch.Tensor, \n                cache: Optional[Tuple[torch.Tensor, int]] = None\n               ) -> Tuple[torch.Tensor, Tuple[torch.Tensor, int]]:\n        batch_size, seq_len, _ = x.size()\n        \n        # Project Q\n        Q = self.W_q(x).view(batch_size, seq_len, self.num_heads, self.d_k).transpose(1, 2)\n        \n        # Compress KV\n        kv_compressed = self.kv_compress(x)\n        \n        # Handle cache and position\n        if cache is not None:\n            cached_kv, start_pos = cache\n            kv_compressed_full = torch.cat([cached_kv, kv_compressed], dim=1)\n        else:\n            kv_compressed_full = kv_compressed\n            start_pos = 0\n        \n        # Decompress K,V\n        K_full = self.k_decompress(kv_compressed_full)\n        V_full = self.v_decompress(kv_compressed_full)\n        \n        seq_len_full = K_full.size(1)\n        K = K_full.view(batch_size, seq_len_full, self.num_heads, self.d_k).transpose(1, 2)\n        V = V_full.view(batch_size, seq_len_full, self.num_heads, self.d_k).transpose(1, 2)\n        \n        # Apply RoPE to Q (current positions)\n        Q, _ = self.rope(Q, Q, start_pos=start_pos + seq_len_full - seq_len)\n        \n        # Apply RoPE to K (all positions including cache)\n        _, K = self.rope(K, K, start_pos=0)  # K includes all positions from 0\n        \n        # Compute attention\n        scores = torch.matmul(Q, K.transpose(-2, -1)) / math.sqrt(self.d_k)\n        \n        # Causal mask\n        mask = torch.tril(torch.ones(seq_len, seq_len_full, device=x.device))\n        mask = mask.view(1, 1, seq_len, seq_len_full)\n        scores = scores.masked_fill(mask == 0, float('-inf'))\n        \n        attn_weights = F.softmax(scores, dim=-1)\n        attn_weights = self.dropout(attn_weights)\n        \n        attn_output = torch.matmul(attn_weights, V)\n        attn_output = attn_output.transpose(1, 2).contiguous().view(batch_size, seq_len, self.d_model)\n        \n        output = self.W_o(attn_output)\n        \n        # Update position for next iteration\n        new_start_pos = start_pos + seq_len\n        \n        return output, (kv_compressed_full, new_start_pos)\n\n\n# Example: Autoregressive generation with MLA + RoPE\nif __name__ == \"__main__\":\n    batch_size = 2\n    d_model = 2048\n    num_heads = 16\n    c_kv = 256\n    \n    model = MLAWithRoPE(d_model, num_heads, c_kv)\n    \n    # Prefill phase\n    prompt_len = 50\n    x_prompt = torch.randn(batch_size, prompt_len, d_model)\n    output, cache = model(x_prompt)\n    print(f\"Prefill output: {output.shape}\")\n    print(f\"Cache size: {cache[0].shape}, Position: {cache[1]}\")\n    \n    # Generation phase (one token at a time)\n    num_gen_tokens = 10\n    for i in range(num_gen_tokens):\n        x_new = torch.randn(batch_size, 1, d_model)  # Single token\n        output, cache = model(x_new, cache=cache)\n        print(f\"Generated token {i+1}, position: {cache[1]}\")"
        }
