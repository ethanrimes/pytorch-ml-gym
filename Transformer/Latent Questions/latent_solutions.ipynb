          "id": "mamba_ssm_basic",
          "title": "Basic Selective SSM",
          "code": "import torch\nimport torch.nn as nn\nimport torch.nn.functional as F\nfrom typing import Tuple\n\nclass SelectiveSSM(nn.Module):\n    \"\"\"Core Selective State Space Model (simplified version)\"\"\"\n    def __init__(self, d_model: int, d_state: int = 16, dt_rank: int = None):\n        super().__init__()\n        self.d_model = d_model\n        self.d_state = d_state\n        self.dt_rank = dt_rank or (d_model // 16)\n        \n        # State matrix A (often initialized with special structure like S4)\n        # For simplicity, we'll use learnable diagonal A\n        self.A = nn.Parameter(torch.randn(d_state))\n        \n        # Input-dependent B projection: x -> B\n        self.B_proj = nn.Linear(d_model, d_state, bias=False)\n        \n        # Input-dependent C projection: x -> C\n        self.C_proj = nn.Linear(d_model, d_state, bias=False)\n        \n        # Input-dependent delta (timestep): x -> delta\n        # Use low-rank projection if dt_rank specified\n        if dt_rank < d_model:\n            self.dt_proj = nn.Sequential(\n                nn.Linear(d_model, dt_rank, bias=False),\n                nn.Linear(dt_rank, 1, bias=True)\n            )\n        else:\n            self.dt_proj = nn.Linear(d_model, 1, bias=True)\n        \n        # Initialize A to be negative for stability\n        with torch.no_grad():\n            self.A.data = -torch.exp(torch.randn(d_state))\n    \n    def discretize(self, A: torch.Tensor, B: torch.Tensor, \n                   delta: torch.Tensor) -> Tuple[torch.Tensor, torch.Tensor]:\n        \"\"\"\n        Discretize continuous SSM to discrete-time.\n        \n        Continuous: dh/dt = Ah + Bx\n        Discrete:   h_t = A̅h_{t-1} + B̅x_t\n        \n        Where:\n            A̅ = exp(delta * A)\n            B̅ = delta * B\n        \n        Args:\n            A: (d_state,) - state matrix (diagonal)\n            B: (batch, seq_len, d_state) - input matrix\n            delta: (batch, seq_len, 1) - timestep\n        \n        Returns:\n            A_bar: (batch, seq_len, d_state) - discretized A\n            B_bar: (batch, seq_len, d_state) - discretized B\n        \"\"\"\n        # A is diagonal, so exp is element-wise\n        # Expand A for batch and sequence\n        A_expanded = A.unsqueeze(0).unsqueeze(0)  # (1, 1, d_state)\n        \n        # A̅ = exp(delta * A)\n        A_bar = torch.exp(delta * A_expanded)  # (batch, seq_len, d_state)\n        \n        # B̅ = delta * B\n        B_bar = delta * B  # (batch, seq_len, d_state)\n        \n        return A_bar, B_bar\n    \n    def forward(self, x: torch.Tensor) -> torch.Tensor:\n        \"\"\"\n        Args:\n            x: (batch, seq_len, d_model)\n        Returns:\n            y: (batch, seq_len, d_model)\n        \"\"\"\n        batch_size, seq_len, _ = x.size()\n        device = x.device\n        \n        # Compute input-dependent parameters\n        B = self.B_proj(x)  # (batch, seq_len, d_state)\n        C = self.C_proj(x)  # (batch, seq_len, d_state)\n        delta = F.softplus(self.dt_proj(x))  # (batch, seq_len, 1), ensure positive\n        \n        # Discretize\n        A_bar, B_bar = self.discretize(self.A, B, delta)\n        \n        # Run SSM recurrence: h_t = A̅h_{t-1} + B̅x_t\n        # For simplicity, we'll use a loop (in practice, use parallel scan)\n        h = torch.zeros(batch_size, self.d_state, device=device, dtype=x.dtype)\n        outputs = []\n        \n        for t in range(seq_len):\n            # Get parameters for this timestep\n            A_t = A_bar[:, t, :]  # (batch, d_state)\n            B_t = B_bar[:, t, :]  # (batch, d_state)\n            x_t = x[:, t, :]      # (batch, d_model)\n            C_t = C[:, t, :]      # (batch, d_state)\n            \n            # Update state: h_t = A_t ⊙ h_{t-1} + B_t (element-wise for diagonal A)\n            h = A_t * h + B_t\n            \n            # Compute output: y_t = C_t @ h_t\n            y_t = torch.sum(C_t * h, dim=-1, keepdim=True)  # (batch, 1)\n            outputs.append(y_t)\n        \n        # Stack outputs\n        y = torch.cat(outputs, dim=1).unsqueeze(-1)  # (batch, seq_len, 1)\n        \n        # Broadcast to d_model (simple approach; in practice, use a projection)\n        y = y.expand(-1, -1, self.d_model)\n        \n        return y\n\n\n# Example usage\nif __name__ == \"__main__\":\n    batch_size = 4\n    seq_len = 32\n    d_model = 256\n    d_state = 16\n    \n    ssm = SelectiveSSM(d_model, d_state)\n    \n    x = torch.randn(batch_size, seq_len, d_model)\n    y = ssm(x)\n    \n    print(f\"Input: {x.shape}\")\n    print(f\"Output: {y.shape}\")\n    print(f\"State dimension: {d_state} (much smaller than {d_model})\")\n    print(f\"\\nKey features:\")\n    print(f\"- Input-dependent B, C, delta (selectivity!)\")\n    print(f\"- Fixed-size state: O(d_state) memory\")\n    print(f\"- Linear complexity: O(N * d_state)\")"
        },
        {
          "id": "mamba_block",
          "title": "Mamba Block Architecture",
          "code": "class MambaBlock(nn.Module):\n    \"\"\"Complete Mamba block with gating and convolution\"\"\"\n    def __init__(self, d_model: int, d_inner: int = None, d_state: int = 16, \n                 d_conv: int = 4, expand_factor: int = 2):\n        super().__init__()\n        self.d_model = d_model\n        self.d_inner = d_inner or (expand_factor * d_model)\n        self.d_state = d_state\n        self.d_conv = d_conv\n        \n        # Input projection: expand to 2 * d_inner\n        self.in_proj = nn.Linear(d_model, 2 * self.d_inner, bias=False)\n        \n        # 1D convolution for local context (depthwise)\n        # Applied to the SSM path before SSM\n        self.conv1d = nn.Conv1d(\n            in_channels=self.d_inner,\n            out_channels=self.d_inner,\n            kernel_size=d_conv,\n            groups=self.d_inner,  # depthwise\n            padding=d_conv - 1,\n        )\n        \n        # Selective SSM\n        self.ssm = SelectiveSSM(self.d_inner, d_state)\n        \n        # Output projection: d_inner -> d_model\n        self.out_proj = nn.Linear(self.d_inner, d_model, bias=False)\n        \n        # Normalization\n        self.norm = nn.LayerNorm(d_model)\n    \n    def forward(self, x: torch.Tensor) -> torch.Tensor:\n        \"\"\"\n        Args:\n            x: (batch, seq_len, d_model)\n        Returns:\n            output: (batch, seq_len, d_model)\n        \"\"\"\n        batch_size, seq_len, _ = x.size()\n        \n        # Save for residual\n        residual = x\n        \n        # Project and split into two paths\n        x_proj = self.in_proj(x)  # (batch, seq_len, 2*d_inner)\n        x_ssm, x_gate = x_proj.chunk(2, dim=-1)  # Each: (batch, seq_len, d_inner)\n        \n        # Apply conv1d to SSM path (for local dependencies)\n        # Conv1d expects (batch, channels, length)\n        x_ssm_t = x_ssm.transpose(1, 2)  # (batch, d_inner, seq_len)\n        x_ssm_conv = self.conv1d(x_ssm_t)[:, :, :seq_len]  # Trim padding\n        x_ssm_conv = x_ssm_conv.transpose(1, 2)  # (batch, seq_len, d_inner)\n        \n        # Apply activation\n        x_ssm_conv = F.silu(x_ssm_conv)\n        \n        # Run selective SSM\n        x_ssm_out = self.ssm(x_ssm_conv)  # (batch, seq_len, d_inner)\n        \n        # Gating: multiply SSM output with gate path\n        x_gate = F.silu(x_gate)  # Activate gate\n        x_gated = x_ssm_out * x_gate  # (batch, seq_len, d_inner)\n        \n        # Output projection\n        output = self.out_proj(x_gated)  # (batch, seq_len, d_model)\n        \n        # Add residual and normalize\n        output = self.norm(residual + output)\n        \n        return output\n\n\n# Stack multiple Mamba blocks\nclass MambaModel(nn.Module):\n    def __init__(self, d_model: int, num_layers: int, d_state: int = 16):\n        super().__init__()\n        self.layers = nn.ModuleList([\n            MambaBlock(d_model, d_state=d_state) for _ in range(num_layers)\n        ])\n        self.norm_f = nn.LayerNorm(d_model)\n    \n    def forward(self, x: torch.Tensor) -> torch.Tensor:\n        for layer in self.layers:\n            x = layer(x)\n        return self.norm_f(x)\n\n\n# Example usage\nif __name__ == \"__main__\":\n    batch_size = 4\n    seq_len = 128\n    d_model = 512\n    num_layers = 6\n    \n    model = MambaModel(d_model, num_layers)\n    \n    x = torch.randn(batch_size, seq_len, d_model)\n    output = model(x)\n    \n    print(f\"Input: {x.shape}\")\n    print(f\"Output: {output.shape}\")\n    print(f\"\\nMamba advantages:\")\n    print(f\"- O(N) complexity (vs O(N^2) for attention)\")\n    print(f\"- Fixed-size state (vs O(N) KV cache)\")\n    print(f\"- Selective mechanism enables content-based reasoning\")\n    print(f\"- Efficient for long sequences\")\n    \n    # Parameter count\n    params = sum(p.numel() for p in model.parameters())\n    print(f\"\\nTotal parameters: {params:,}\")"
        },
        {
          "id": "mamba_scan",
          "title": "Parallel Associative Scan",
          "code": "def parallel_scan_simple(A_bar: torch.Tensor, B_bar_x: torch.Tensor) -> torch.Tensor:\n    \"\"\"\n    Simplified parallel scan for SSM.\n    \n    Recurrence: h_t = A_t * h_{t-1} + b_t\n    \n    Args:\n        A_bar: (batch, seq_len, d_state) - discretized A matrices\n        B_bar_x: (batch, seq_len, d_state) - discretized B * x terms\n    \n    Returns:\n        h: (batch, seq_len, d_state) - all hidden states\n    \"\"\"\n    batch_size, seq_len, d_state = A_bar.shape\n    device = A_bar.device\n    \n    # For simplicity, we'll use cumulative product approach\n    # In production, use more efficient parallel scan kernels\n    \n    # Initialize outputs\n    h = torch.zeros(batch_size, seq_len, d_state, device=device, dtype=A_bar.dtype)\n    \n    # Compute cumulative products and sums\n    # This is a simplified O(N) version; true parallel scan is O(log N) depth\n    h_prev = torch.zeros(batch_size, d_state, device=device, dtype=A_bar.dtype)\n    \n    for t in range(seq_len):\n        A_t = A_bar[:, t, :]      # (batch, d_state)\n        b_t = B_bar_x[:, t, :]    # (batch, d_state)\n        \n        # h_t = A_t * h_{t-1} + b_t\n        h_t = A_t * h_prev + b_t\n        h[:, t, :] = h_t\n        h_prev = h_t\n    \n    return h\n\n\ndef parallel_scan_efficient(elements: torch.Tensor, \n                           binary_op, \n                           identity) -> torch.Tensor:\n    \"\"\"\n    Generic parallel scan (prefix sum) with arbitrary associative operator.\n    \n    This is a conceptual implementation. For production:\n    - Use specialized CUDA kernels\n    - Implement tree-based parallel reduction\n    - Handle numerical stability\n    \n    Args:\n        elements: input elements to scan\n        binary_op: associative binary operator (A, B) -> C\n        identity: identity element for the operator\n    \n    Returns:\n        scanned: prefix scan of elements\n    \"\"\"\n    # Simplified version using PyTorch's built-in operations\n    # Real implementation would use custom CUDA kernel\n    \n    # For SSM, the binary operator is:\n    # (A1, b1) ⊕ (A2, b2) = (A2 * A1, A2 * b1 + b2)\n    \n    # This is conceptual - in practice, use triton or CUDA\n    raise NotImplementedError(\"Use specialized kernel for production\")\n\n\n# Efficient Mamba with parallel scan (conceptual)\nclass EfficientSelectiveSSM(nn.Module):\n    \"\"\"SSM with parallel scan for efficient training\"\"\"\n    def __init__(self, d_model: int, d_state: int = 16):\n        super().__init__()\n        self.d_model = d_model\n        self.d_state = d_state\n        \n        # Same projections as before\n        self.A = nn.Parameter(-torch.exp(torch.randn(d_state)))\n        self.B_proj = nn.Linear(d_model, d_state, bias=False)\n        self.C_proj = nn.Linear(d_model, d_state, bias=False)\n        self.dt_proj = nn.Linear(d_model, 1, bias=True)\n    \n    def forward(self, x: torch.Tensor) -> torch.Tensor:\n        batch_size, seq_len, _ = x.size()\n        \n        # Compute input-dependent parameters\n        B = self.B_proj(x)\n        C = self.C_proj(x)\n        delta = F.softplus(self.dt_proj(x))\n        \n        # Discretize\n        A_expanded = self.A.unsqueeze(0).unsqueeze(0)\n        A_bar = torch.exp(delta * A_expanded)\n        B_bar_x = delta * B  # Assuming x is already incorporated\n        \n        # Use parallel scan for efficient computation\n        h = parallel_scan_simple(A_bar, B_bar_x)\n        \n        # Compute outputs: y_t = C_t * h_t\n        y = torch.sum(C * h, dim=-1, keepdim=True)\n        y = y.expand(-1, -1, self.d_model)\n        \n        return y\n\n\nif __name__ == \"__main__\":\n    print(\"=== Parallel Scan Benefits ===\")\n    print(\"Sequential computation: O(N) time, no parallelism\")\n    print(\"Parallel scan: O(N) work, O(log N) depth\")\n    print(\"\\nKey insight: SSM recurrence is associative!\")\n    print(\"This enables efficient GPU parallelization\")\n    print(\"\\nFor production:\")\n    print(\"- Use Triton or custom CUDA kernels\")\n    print(\"- Implement tree-based reduction\")\n    print(\"- Handle numerical precision carefully\")"
        }
